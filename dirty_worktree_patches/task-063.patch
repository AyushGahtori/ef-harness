+    const idempotence = results.find((result) => result.check_id.endsWith(":idempotence"));
+    expect(preservation?.status).toBe("pass");
+    expect(idempotence?.status).toBe("pass");
+    expect(idempotence?.receipt.cleanRefusal).toBe(true);
+  });
