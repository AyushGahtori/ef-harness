{
  "name": "@ef-harness/brownfield",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node scripts/copy-grammars.mjs && tsc -p tsconfig.json --pretty false",
    "pretest": "node scripts/copy-grammars.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@ef-harness/db": "workspace:*",
    "@ef-harness/discovery": "workspace:*",
    "@ef-harness/git-engine": "workspace:*",
    "@ef-harness/planner": "workspace:*",
    "@ef-harness/sandbox": "workspace:*",
    "@ef-harness/shared-contracts": "workspace:*",
    "@ef-harness/shared-observability": "workspace:*",
    "@ef-harness/test-env": "workspace:*",
    "web-tree-sitter": "0.27.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
