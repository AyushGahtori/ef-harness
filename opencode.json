{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "task-worker",
  "compaction": {
    "auto": false
  },
  "tools": {
    "webfetch": false,
    "websearch": false
  },
  "permission": {
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "node scripts/agent-worktree.mjs*": "allow",
      "node scripts/verify-harmony.mjs*": "allow",
      "node scripts/verify-env.mjs*": "allow",
      "node scripts/verify-diagrams.mjs*": "allow",
      "node scripts/opencode-smoke.mjs*": "allow",
      "node schema/schema-test.js*": "allow",
      "node tools/merge-diagrams.js*": "allow",
      "pnpm --filter *": "allow",
      "pnpm typecheck*": "allow",
      "pnpm lint*": "allow",
      "pnpm test*": "allow",
      "pnpm build*": "allow",
      "pnpm verify:env*": "allow",
      "pnpm verify:harmony*": "allow",
      "pnpm verify:diagrams*": "allow",
      "pnpm test:schema*": "allow",
      "pnpm run typecheck*": "allow",
      "pnpm run lint*": "allow",
      "pnpm run test*": "allow",
      "pnpm run build*": "allow",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git push*": "deny",
      "git pull*": "deny",
      "git checkout main*": "deny",
      "git checkout master*": "deny",
      "git checkout harness/*": "deny",
      "git switch main*": "deny",
      "git switch harness/*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git commit*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "Invoke-WebRequest*": "deny",
      "npm i -g*": "deny",
      "npm install -g*": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env.example": "allow",
      ".env.example": "allow",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.claude/**": "deny",
      "**/.codex/**": "deny",
      "**/.gemini/**": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env.example": "allow",
      ".env.example": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "glob": "allow",
    "grep": "allow",
    "list": "allow"
  }
}
