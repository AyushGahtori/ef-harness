    "@parcel/watcher": "^2.5.1",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@xyflow/react": "^13.0.2",
    "age-encryption": "^0.3.1",
    "axe-core": "^4.10.0",
    "dompurify": "^3.2.0",
    "electron": ">=42",
    "electron-builder": "^26.18.0",
    "elkjs": "^0.10.0",
    "eslint": "catalog:",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^4.1.0",
    "fontkit": "^2.0.4",
    "knip": "^5.60.0",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^5.4.0",
    "pixi.js": "^8.6.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0",
    "source-map": "^0.7.4",
    "stylelint": "^16.24.0",
    "ts-morph": ">=25",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
