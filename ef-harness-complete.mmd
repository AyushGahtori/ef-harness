      direction TB
        subgraph ha_IN["1 · Describe the project"]
          ha_SETUP["Connect AI: API keys, plan sign-in or installed agent, local model<br/>Pick folder · Git set up or dirty work snapshotted"] --> ha_MODE{"How would you like to start?"}
          ha_MODE --> ha_ALL["All five at once · examples folded"]
          ha_MODE --> ha_ONE["One at a time · example open"]
          ha_ONE & ha_ALL --> ha_FIVE["What are you building? Who needs it and why?<br/>Walk through one use. What must the demo prove?<br/>Which choices are fixed or delegated?"]
          ha_FIVE --> ha_DRAFT["Always-enabled text or dictation<br/>One answer can cover multiple topics"]
          ha_DRAFT -.-> ha_PREVIEW["Local transcript only · pauses never submit<br/>Graph updates once, after Send"]
          ha_DRAFT -->|Explicit submission| ha_TURN["Sequenced, versioned user turn<br/>Record author, spans, focus and retractions"]
          ha_REPO["Existing project: inspect pinned repo and tests<br/>Record observations separately from desired behavior"]
        end
        subgraph ha_DISC["2 · Discover enough to build this scope"]
          ha_OPEN["Opening review proposes supported answers and domains<br/>Actor, action and observable result can establish a workflow"]
          ha_POOL["Code selects from shared and domain question indexes<br/>Filter by prerequisites; score additional uncovered criteria<br/>Rescore after each pick, up to five; use 2–3 for a small change"]
          ha_CUSTOM["No suitable entry: derive one scoped project question<br/>Require a concrete gap, rubric and remaining budget"]
          ha_PROPOSE["Small resolver proposes one value per criterion<br/>Only relevant turns, rule and current premises"]
          ha_CHECK["Validate current source, quote, meaning and inference rule<br/>Unresolved siblings and delegated-but-unchosen values stay open"]
          ha_Q["Focused question queue · one concrete gap or conflict<br/>Explain, offer options or free text, keep the same question ID"]
          ha_FACTS["Code records supported facts and their dependencies<br/>Correcting one rechecks the claims that used it"]
          ha_READY{"Exact scoped decisions resolved, inherited prerequisites met,<br/>no critical gaps, completeness pass finished?"}
          ha_DEFER["Explicit milestone deferral needs an independent interface<br/>Show overall detail and which consumers remain blocked"]
          ha_PAUSE["Repeated gap or exhausted budget:<br/>show the blocker and wait for new evidence"]
          ha_TURN -->|New project discovery| ha_OPEN
          ha_REPO -.-> ha_OPEN
          ha_OPEN -->|Opening anchor missing| ha_Q
          ha_OPEN -->|Enough to choose domains| ha_POOL --> ha_PROPOSE --> ha_CHECK
          ha_POOL -->|Uncovered criterion| ha_CUSTOM --> ha_PROPOSE
          ha_CHECK -->|Accept supported siblings now| ha_FACTS --> ha_READY
          ha_CHECK -->|Missing or conflicting| ha_Q
          ha_Q -->|Bound opening answer| ha_OPEN
          ha_Q -->|Current criterion and new evidence| ha_PROPOSE
          ha_CHECK -->|User defers| ha_DEFER --> ha_READY
          ha_READY -->|Useful gaps remain| ha_POOL
          ha_READY -->|No progress| ha_PAUSE
        end
        subgraph ha_PLAN["3 · Publish a buildable plan"]
          ha_GRAPH["Construct architecture nodes and typed links<br/>Requirements, contracts, UI, edge cases, tests and ownership"]
          ha_FILES["Planner proposes master plan → feature → task → optional child<br/>Pin behavior, interfaces, paths, steps, UI states and selected skills"]
          ha_EX["Planner pins visible examples before implementation; oracle-author<br/>writes held-back cases for rule logic; verify red-before-green"]
          ha_K["Coordinator is code · sole writer to canonical SQLite state<br/>Validate authority, lease, relevant node and edge versions, budgets"]
          ha_SNAP["Atomic revision: graph, briefs, audit and outbox<br/>Export versioned Markdown, JSON and readable Mermaid views"]
          ha_PV{"Plan preview: Phase 0, tasks, crew, cost and time<br/>First build waits for Start build; small revisions may auto-start"}
          ha_SPEC["Spec expansion: matrices, every cell with a basis<br/>Contradictions checked by code, then model"]
          ha_RS["Risk-triggered research · quotes verified<br/>Feature details produced one wave ahead"]
          ha_READY -->|Yes, automatically| ha_SPEC --> ha_RS --> ha_GRAPH --> ha_FILES --> ha_EX --> ha_K --> ha_SNAP --> ha_PV
